#!/bin/bash
# Claude Code の Stop hook から呼ばれ、発火元の tmux session/window を
# Noroshi.app に URL スキームで通知する。
# このスクリプト自体は状態を持たない。ただし冪等ではない: 1 回の呼び出しが
# アプリ側のバッジを 1 加算する「イベント通知」であり、重複実行の抑止は
# hook の発火回数 (Stop 1 回につき 1 回) に委ねるため。
# tmux 外や tmux/アプリ不在の環境では何もせず正常終了する (Claude 側を絶対にブロックしない)。
set -u

[ -n "${TMUX_PANE:-}" ] || exit 0
command -v tmux >/dev/null 2>&1 || exit 0

session=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null) || exit 0
window=$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null) || exit 0
[ -n "$session" ] && [ -n "$window" ] || exit 0

# session 名は空白や記号を含み得るため URL エンコードする。
# 特に `#` はエンコードしないと URL の fragment 区切りとして window パラメータを切り落とし、通知が黙って失われる。
# jq 不在時も bash で percent-encode する (unreserved 文字以外はすべて %XX 化)。
if command -v jq >/dev/null 2>&1; then
  session_enc=$(printf %s "$session" | jq -sRr @uri)
else
  # 本体 shebang の /bin/bash は 3.2 で $(...) 内の case が構文エラーになるため、
  # 命令置換を使わず session_enc へ直接組み立てる。マルチバイトはバイト単位で符号化するため C ロケールにする。
  LC_ALL=C
  session_enc=
  for ((i = 0; i < ${#session}; i++)); do
    c=${session:i:1}
    case $c in
      [a-zA-Z0-9.~_-]) session_enc+=$c ;;
      # "'$c" のバイト値は上位ビット立ちで符号拡張されるため & 0xFF で 1 バイトに丸める
      *) printf -v ord '%d' "'$c"; printf -v hex '%%%02X' "$(( ord & 0xFF ))"; session_enc+=$hex ;;
    esac
  done
fi

# -g: アプリをフォアグラウンド化せずに URL イベントを届ける (未起動なら背面で起動)
open -g "noroshi://stop?session=${session_enc}&window=${window}" 2>/dev/null || true
exit 0
