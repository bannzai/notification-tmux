#!/usr/bin/env bash
# issue #67 Phase 0: nested tmux の外側「額縁」を構築・操作するスパイクスクリプト
#
# 構成:
#   外側 tmux (別 socket。~/.tmux.conf を読まず outer.conf のみ)
#   └─ session "noroshi" / window 0 (1 枚固定)
#      ├─ 左 pane: サイドバー (tui-sidebar/bin/noroshi-sidebar があればそれ、無ければプレースホルダ)
#      └─ 右 pane: TMUX= を外して内側 (普段の) tmux server へ attach
#
# 使い方:
#   noroshi-outer start   外側を構築して attach する (構築済みなら attach のみ = 冪等)。
#                         内側 tmux に「prefix + N でサイドバーへフォーカス」のキーバインドと、
#                         @claude-waiting の変化を doorbell ファイルへ伝える after-set-option hook を
#                         注入する (メモリ上のみ。conf ファイルは変更しない)
#   noroshi-outer toggle  サイドバーの表示/非表示を切り替える
#   noroshi-outer focus {sidebar|inner|toggle}
#                         フォーカスを移す (sidebar 指定時、非表示なら表示してから移す)
#   noroshi-outer status  外側の状態を表示する
#   noroshi-outer stop    外側 server を落とし、内側へ注入したキーバインドと hook を解除する
#                         (内側の session・window には一切触れない)
#
# フォーカス移動の役割分担 (外側はキーを 1 つも掴まない):
#   内側 → サイドバー: 内側 tmux の prefix + N (start が注入する run-shell バインド)
#   サイドバー → 内側: サイドバー側のキー処理 (サイドバーが解釈しないキーで戻る)
#   マウスクリックでも両方向に移動できる (外側 mouse on)
#
# 環境変数 (すべて任意):
#   NOROSHI_OUTER_SOCKET    外側 socket 名 (default: noroshi)
#   NOROSHI_INNER_TMUX      内側 server へ命令する時の tmux コマンド (default: tmux)
#                           検証用に "tmux -L <隔離socket>" へ差し替えられる
#   NOROSHI_INNER_TMUX_CMD  右 pane で実行する内側への接続コマンド (default: $NOROSHI_INNER_TMUX attach)
#   NOROSHI_INNER_JUMP_KEY  内側に注入する「サイドバーへ」の prefix キー (default: N)
#   NOROSHI_SIDEBAR_CMD     左 pane で実行するコマンド
#                           (default: tui-sidebar/bin/noroshi-sidebar。無ければ sidebar-placeholder.sh)
#   NOROSHI_SIDEBAR_WIDTH   サイドバーの幅 (default: 40)
#   NOROSHI_DOORBELL_FILE   @claude-waiting の変化をサイドバーへ知らせる touch 先
#                           (default: ${XDG_STATE_HOME:-$HOME/.local/state}/noroshi/doorbell)
set -euo pipefail

SPIKE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOCKET="${NOROSHI_OUTER_SOCKET:-noroshi}"
CONF="${NOROSHI_OUTER_CONF:-$SPIKE_DIR/outer.conf}"
SESSION="noroshi"
SIDEBAR_WIDTH="${NOROSHI_SIDEBAR_WIDTH:-40}"
INNER_TMUX="${NOROSHI_INNER_TMUX:-tmux}"
INNER_CMD="${NOROSHI_INNER_TMUX_CMD:-$INNER_TMUX attach}"
JUMP_KEY="${NOROSHI_INNER_JUMP_KEY:-N}"
DOORBELL="${NOROSHI_DOORBELL_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/noroshi/doorbell}"
SIDEBAR_BIN="$SPIKE_DIR/../tui-sidebar/bin/noroshi-sidebar"
if [ -x "$SIDEBAR_BIN" ]; then
  DEFAULT_SIDEBAR_CMD="NOROSHI_OUTER_SOCKET='$SOCKET' NOROSHI_INNER_TMUX='$INNER_TMUX' NOROSHI_DOORBELL_FILE='$DOORBELL' '$SIDEBAR_BIN'"
else
  DEFAULT_SIDEBAR_CMD="NOROSHI_OUTER_SOCKET='$SOCKET' NOROSHI_INNER_JUMP_KEY='$JUMP_KEY' bash '$SPIKE_DIR/sidebar-placeholder.sh'"
fi
SIDEBAR_CMD="${NOROSHI_SIDEBAR_CMD:-$DEFAULT_SIDEBAR_CMD}"

t() { tmux -L "$SOCKET" "$@"; }
# INNER_TMUX は "tmux -L socket" のような複数語を許すため、意図的にクオートせず word split する
inner_t() { $INNER_TMUX "$@"; }

outer_exists() { t has-session -t "$SESSION" 2>/dev/null; }

sidebar_pane_id() {
  t list-panes -t "$SESSION:0" -f '#{@noroshi-sidebar}' -F '#{pane_id}' 2>/dev/null | head -1
}

inner_pane_id() {
  t list-panes -t "$SESSION:0" -f '#{?#{@noroshi-sidebar},0,1}' -F '#{pane_id}' 2>/dev/null | head -1
}

# サイドバー pane が無ければ左側に作る (あれば何もしない = 冪等)
sidebar_open() {
  [ -n "$(sidebar_pane_id)" ] && return 0
  local pane_id
  pane_id=$(t split-window -hb -d -P -F '#{pane_id}' -l "$SIDEBAR_WIDTH" -t "$SESSION:0" \
    "$SIDEBAR_CMD")
  t set-option -p -t "$pane_id" @noroshi-sidebar 1
}

# 内側 tmux に「prefix + JUMP_KEY でサイドバーへ」を注入する (メモリ上のみ・冪等)。
# 内側 server が起動していない場合は何もしない
install_inner_jump_key() {
  inner_t bind-key "$JUMP_KEY" run-shell \
    "NOROSHI_OUTER_SOCKET='$SOCKET' '$SPIKE_DIR/noroshi-outer' focus sidebar" \
    2>/dev/null || true
}

# 内側 tmux の「どこかで set-option された」を doorbell ファイルへ伝える hook を注入する
# (メモリ上のみ・冪等)。control mode の購読は attach 中 session の pane に限られるため、
# 別 session の @claude-waiting を拾う経路はこの global hook が担う。
# hook 内で set-option すると再帰発火するため touch しか行わない
install_notification_hook() {
  mkdir -p "$(dirname "$DOORBELL")"
  inner_t set-hook -g after-set-option "run-shell -b \"touch '$DOORBELL'\"" 2>/dev/null || true
}

cmd_start() {
  if ! outer_exists; then
    # -f は server 起動時のみ効くため、server を生む new-session に付ける
    tmux -L "$SOCKET" -f "$CONF" new-session -d -s "$SESSION" -x 220 -y 60 \
      "TMUX= $INNER_CMD"
    sidebar_open
  fi
  install_inner_jump_key
  install_notification_hook
  if [ -t 0 ]; then
    if [ -n "${TMUX:-}" ]; then
      echo "エラー: tmux の中から start しないでください (外側が二重にネストします)。新しいターミナル pane から実行してください" >&2
      exit 1
    fi
    exec tmux -L "$SOCKET" -f "$CONF" attach -t "$SESSION"
  fi
  echo "外側 tmux (socket: $SOCKET) を構築しました。attach: tmux -L $SOCKET attach -t $SESSION"
}

cmd_toggle() {
  outer_exists || { echo "エラー: 外側 tmux がありません。先に start してください" >&2; exit 1; }
  local sid
  sid=$(sidebar_pane_id)
  if [ -n "$sid" ]; then
    t kill-pane -t "$sid"
  else
    sidebar_open
  fi
}

cmd_focus() {
  outer_exists || { echo "エラー: 外側 tmux がありません。先に start してください" >&2; exit 1; }
  local target="${1:-toggle}"
  if [ "$target" = "toggle" ]; then
    if [ "$(t list-panes -t "$SESSION:0" -f '#{pane_active}' -F '#{@noroshi-sidebar}')" = 1 ]; then
      target=inner
    else
      target=sidebar
    fi
  fi
  case "$target" in
    sidebar)
      sidebar_open
      t select-pane -t "$(sidebar_pane_id)"
      ;;
    inner)
      t select-pane -t "$(inner_pane_id)"
      ;;
    *)
      echo "usage: noroshi-outer focus {sidebar|inner|toggle}" >&2
      exit 64
      ;;
  esac
}

cmd_status() {
  if ! outer_exists; then
    echo "外側 tmux (socket: $SOCKET): 未起動"
    return 0
  fi
  echo "外側 tmux (socket: $SOCKET): 起動中"
  t list-panes -t "$SESSION:0" -F '  pane #{pane_id} #{pane_width}x#{pane_height} active=#{pane_active} sidebar=#{@noroshi-sidebar} cmd=#{pane_current_command}'
}

cmd_stop() {
  # 注入したキーバインドと hook の解除は外側の有無に関わらず行う (冪等)
  inner_t unbind-key "$JUMP_KEY" 2>/dev/null || true
  inner_t set-hook -gu after-set-option 2>/dev/null || true
  outer_exists || { echo "外側 tmux (socket: $SOCKET): 未起動"; return 0; }
  t kill-server
  echo "外側 tmux (socket: $SOCKET) を停止しました (内側 tmux には触れていません)"
}

case "${1:-}" in
  start)  cmd_start ;;
  toggle) cmd_toggle ;;
  focus)  cmd_focus "${2:-toggle}" ;;
  status) cmd_status ;;
  stop)   cmd_stop ;;
  *)      echo "usage: noroshi-outer {start|toggle|focus|status|stop}" >&2; exit 64 ;;
esac
